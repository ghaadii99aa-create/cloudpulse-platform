# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (docker compose uses these to create the database)
POSTGRES_USER=cloudpulse
POSTGRES_PASSWORD=
POSTGRES_DB=cloudpulse
# Outside compose, point at any PostgreSQL instance:
# DATABASE_URL=postgresql+psycopg://cloudpulse:<password>@localhost:5432/cloudpulse

# Accounts created on first start (only if both values are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_ROLE=viewer

# Shows a one-click, read-only "View the demo" button. Needs DEMO_USER_EMAIL and DEMO_USER_ROLE=viewer
DEMO_LOGIN_ENABLED=false

# Simulated environment
SEED_ON_STARTUP=true
SIMULATION_DAYS=120
# Pin the simulation clock for reproducible demos, e.g. 2026-11-08 14:00 (leave empty to follow real time)
SIMULATION_END=

# Alert thresholds (percent)
CPU_WARNING_PCT=85
CPU_CRITICAL_PCT=95
MEMORY_WARNING_PCT=85
MEMORY_CRITICAL_PCT=95
CAPACITY_THRESHOLD_PCT=85
CAPACITY_ALERT_DAYS=14

# AI Cloud Advisor: leave empty for the labeled rule-based fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ADVISOR_REQUESTS_PER_HOUR=20

# Optional integrations (not needed for the demo)
KUBERNETES_MODE=simulated
AWS_COST_ROLE_ARN=
AZURE_SUBSCRIPTION_ID=

# Monitoring
# Protects /metrics when the API is reachable from the internet; Prometheus must then send it as a bearer token
METRICS_TOKEN=
# Required for: docker compose --profile monitoring up
GRAFANA_ADMIN_PASSWORD=
