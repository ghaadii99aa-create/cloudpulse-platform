# One container for hosts that run a single web service: the API also serves the built dashboard.
# Build from the repository root:  docker build -f Dockerfile.render -t cloudpulse-demo .
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npx vite build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 WEB_DIST=/app/web
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
COPY analytics /tmp/analytics
RUN pip install /tmp/analytics -r requirements.txt && rm -rf /tmp/analytics
COPY backend/app ./app
COPY --from=web /web/dist ./web
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin cloudpulse
USER 10001
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
